{
  "openapi": "3.0.4",
  "info": {
    "title": "Duplicate operationId",
    "description": "An invalid document declaring the operationId `getPet` twice, with a different operation in between; the first occurrence wins.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://petstore.example.com/api/v3" }],
  "paths": {
    "/pet/first": {
      "get": {
        "operationId": "getPet",
        "responses": { "200": { "description": "first" } }
      }
    },
    "/store/inventory": {
      "get": {
        "operationId": "getInventory",
        "responses": { "200": { "description": "inventory" } }
      }
    },
    "/pet/second": {
      "get": {
        "operationId": "getPet",
        "responses": { "200": { "description": "second" } }
      }
    }
  }
}
