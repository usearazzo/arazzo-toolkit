{
  "openapi": "3.1.0",
  "info": { "title": "API key in the query", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "components": {
    "securitySchemes": {
      "queryKey": { "type": "apiKey", "name": "key", "in": "query" }
    }
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "security": [{ "queryKey": [] }],
        "parameters": [{ "name": "page", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
