{
  "openapi": "3.1.0",
  "info": { "title": "Multipart upload", "version": "1.0.0" },
  "servers": [{ "url": "https://upload.example" }],
  "paths": {
    "/files": {
      "post": {
        "operationId": "uploadFile",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "name": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Uploaded" } }
      }
    }
  }
}
