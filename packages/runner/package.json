{
  "name": "@usearazzo/runner",
  "version": "1.0.1-alpha.38",
  "description": "Runner for Arazzo Workflows.",
  "keywords": [
    "arazzo",
    "arazzo-specification",
    "runner",
    "execute",
    "executor",
    "workflow",
    "workflows",
    "api",
    "api-workflow"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true,
    "tag": "latest",
    "timeout": 60000
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.10.0"
  },
  "unpkg": "./dist/arazzo-runner.browser.min.js",
  "main": "./src/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./types/runner.d.ts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./types/runner.d.cts",
        "default": "./src/index.cjs"
      }
    },
    "./observability/logging": {
      "import": {
        "types": "./types/observability/logging/index.d.ts",
        "default": "./src/observability/logging/index.mjs"
      },
      "require": {
        "types": "./types/observability/logging/index.d.cts",
        "default": "./src/observability/logging/index.cjs"
      }
    },
    "./observability/stream": {
      "import": {
        "types": "./types/observability/stream/index.d.ts",
        "default": "./src/observability/stream/index.mjs"
      },
      "require": {
        "types": "./types/observability/stream/index.d.cts",
        "default": "./src/observability/stream/index.cjs"
      }
    },
    "./observability/opentelemetry": {
      "import": {
        "types": "./types/observability/opentelemetry/index.d.ts",
        "default": "./src/observability/opentelemetry/index.mjs"
      },
      "require": {
        "types": "./types/observability/opentelemetry/index.d.cts",
        "default": "./src/observability/opentelemetry/index.cjs"
      }
    }
  },
  "types": "./types/runner.d.ts",
  "scripts": {
    "build": "npm run clean && npm run build:es && run-p --max-parallel ${CPU_CORES:-2} typescript:declaration build:cjs build:umd:browser",
    "build:es": "npm run build:swagger-client && cross-env BABEL_ENV=es babel src --out-dir src --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward'",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir src --extensions '.ts' --out-file-extension '.cjs' --root-mode 'upward'",
    "build:umd:browser": "cross-env BABEL_ENV=browser webpack --config config/webpack/browser.config.js --progress",
    "build:swagger-client": "webpack --config config/webpack/swagger-client.config.js --progress",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "clean": "rimraf --glob 'src/**/*.mjs' 'src/**/*.cjs' 'test/**/*.mjs' ./dist ./types",
    "typescript:check-types": "tsc --noEmit",
    "version": "node ../../scripts/version-update.mjs",
    "typescript:declaration": "tsc -p tsconfig.declaration.json && api-extractor run -l -c ./config/api-extractor/api-extractor.json && node ../../scripts/declarations-cts.mjs",
    "typescript:check-published-types": "attw --pack . --profile node16 && tsc -p test/types/tsconfig.json",
    "test": "npm run build:es && cross-env BABEL_ENV=es babel test --out-dir test --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward' && cross-env NODE_ENV=test mocha",
    "test:e2e": "npm run build:es && cross-env BABEL_ENV=es babel test --out-dir test --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward' && cross-env NODE_ENV=test mocha --config .mocharc.e2e.json",
    "prepack": "copyfiles -u 2 ../../LICENSE . && copyfiles -u 2 ../../NOTICE .",
    "postpack": "rimraf NOTICE LICENSE"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usearazzo/arazzo-toolkit.git"
  },
  "author": "Vladimir Gorej <vladimir.gorej@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/runtime-corejs3": "^8.1.3",
    "@speclynx/apidom-core": "^7.1.1",
    "@speclynx/apidom-datamodel": "^7.1.1",
    "@speclynx/apidom-error": "^7.1.1",
    "@speclynx/apidom-json-pointer": "^7.1.1",
    "@speclynx/apidom-ns-arazzo-1": "^7.1.1",
    "@speclynx/apidom-ns-openapi-2": "^7.1.1",
    "@speclynx/apidom-ns-openapi-3-0": "^7.1.1",
    "@speclynx/apidom-ns-openapi-3-1": "^7.1.1",
    "@speclynx/apidom-reference": "^7.1.1",
    "@speclynx/apidom-traverse": "^7.1.1",
    "@swaggerexpert/arazzo-criterion": "^1.2.0",
    "@swaggerexpert/arazzo-runtime-expression": "^3.4.0",
    "@swaggerexpert/cookie": "^2.2.0",
    "@swaggerexpert/json-pointer": "^3.0.3",
    "@swaggerexpert/jsonpath": "^4.1.0",
    "@swaggerexpert/media-types": "^1.0.3",
    "@usearazzo/parser": "1.0.1-alpha.38",
    "@usearazzo/resolver": "1.0.1-alpha.38",
    "@xmldom/xmldom": "^0.9.12",
    "fontoxpath": "^3.34.0",
    "ramda": "^0.32.0",
    "ramda-adjunct": "^6.1.0",
    "short-unique-id": "^5.3.2"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.cjs",
    "dist/",
    "types/runner.d.ts",
    "types/runner.d.cts",
    "types/observability/logging/",
    "types/observability/stream/",
    "types/observability/opentelemetry/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "swagger-client": "^3.39.0"
  }
}
