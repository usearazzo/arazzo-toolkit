{
  "name": "@usearazzo/runner",
  "version": "1.0.1-alpha.12",
  "description": "Runner for Arazzo Workflows.",
  "keywords": [
    "arazzo",
    "arazzo-specification",
    "runner",
    "execute",
    "executor",
    "workflow",
    "workflows",
    "api",
    "api-workflow"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true,
    "tag": "latest",
    "timeout": 60000
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.10.0"
  },
  "unpkg": "./dist/arazzo-runner.browser.min.js",
  "main": "./src/index.cjs",
  "exports": {
    "types": "./types/runner.d.ts",
    "import": "./src/index.mjs",
    "require": "./src/index.cjs"
  },
  "types": "./types/runner.d.ts",
  "scripts": {
    "build": "npm run clean && npm run build:es && run-p --max-parallel ${CPU_CORES:-2} typescript:declaration build:cjs build:umd:browser",
    "build:es": "npm run build:swagger-client && cross-env BABEL_ENV=es babel src --out-dir src --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward'",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir src --extensions '.ts' --out-file-extension '.cjs' --root-mode 'upward'",
    "build:umd:browser": "cross-env BABEL_ENV=browser webpack --config config/webpack/browser.config.js --progress",
    "build:swagger-client": "webpack --config config/webpack/swagger-client.config.js --progress",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "clean": "rimraf --glob 'src/**/*.mjs' 'src/**/*.cjs' 'test/**/*.mjs' ./dist ./types",
    "typescript:check-types": "tsc --noEmit",
    "typescript:declaration": "tsc -p tsconfig.declaration.json && api-extractor run -l -c ./config/api-extractor/api-extractor.json",
    "test": "npm run build:es && cross-env BABEL_ENV=es babel test --out-dir test --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward' && cross-env NODE_ENV=test mocha",
    "test:e2e": "npm run build:es && cross-env BABEL_ENV=es babel test --out-dir test --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward' && cross-env NODE_ENV=test mocha --config .mocharc.e2e.json",
    "prepack": "copyfiles -u 2 ../../LICENSE . && copyfiles -u 2 ../../NOTICE .",
    "postpack": "rimraf NOTICE LICENSE"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usearazzo/arazzo-toolkit.git"
  },
  "author": "Vladimir Gorej <vladimir.gorej@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/runtime-corejs3": "^8.0.7",
    "@speclynx/apidom-core": "^6.1.0",
    "@speclynx/apidom-datamodel": "^6.1.0",
    "@speclynx/apidom-error": "^6.1.0",
    "@speclynx/apidom-json-pointer": "^6.1.0",
    "@speclynx/apidom-ns-arazzo-1": "^6.1.0",
    "@speclynx/apidom-ns-openapi-2": "^6.1.0",
    "@speclynx/apidom-ns-openapi-3-0": "^6.1.0",
    "@speclynx/apidom-ns-openapi-3-1": "^6.1.0",
    "@speclynx/apidom-reference": "^6.1.0",
    "@speclynx/apidom-traverse": "^6.1.0",
    "@swaggerexpert/arazzo-criterion": "^1.0.1",
    "@swaggerexpert/arazzo-runtime-expression": "^3.3.0",
    "@swaggerexpert/json-pointer": "^3.0.2",
    "@swaggerexpert/jsonpath": "^4.0.5",
    "@swaggerexpert/media-types": "^1.0.1",
    "@usearazzo/parser": "1.0.1-alpha.12",
    "@usearazzo/resolver": "1.0.1-alpha.12",
    "@xmldom/xmldom": "^0.9.12",
    "fontoxpath": "^3.34.0",
    "ramda": "^0.32.0",
    "ramda-adjunct": "^6.1.0",
    "type-fest": "^5.10.0"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.cjs",
    "dist/",
    "types/runner.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "swagger-client": "^3.38.4"
  }
}
