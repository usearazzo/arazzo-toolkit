{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "extends": "../../../../api-extractor.json",
  "mainEntryPointFilePath": "<projectFolder>/types/opentelemetry/index.d.ts",
  "compiler": {
    // The subpath imports the main entry as `@usearazzo/runner`, and its rollup must keep that
    // import rather than inline a second copy of `Redactor` and the event types (a class with
    // private fields would then be incompatible with the one users import). `nodenext` resolves
    // the name to this package's own files, which api-extractor inlines; `node10` with
    // `preserveSymlinks` resolves it through node_modules, which keeps it external.
    "overrideTsconfig": {
      "extends": "../../tsconfig.json",
      "include": ["types/opentelemetry/**/*.d.ts"],
      "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node10",
        "preserveSymlinks": true,
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true
      }
    }
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/types/opentelemetry.d.ts"
  }
}
